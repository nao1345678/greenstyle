# Configuration du backend API
# Copiez ce fichier vers .env et configurez les valeurs

# URL du backend (sans /api à la fin)
# En développement, le proxy Vite gère /api automatiquement
# En production, spécifiez l'URL complète du backend

VITE_API_URL=http://localhost:8000

# Pour production (si backend est sur un autre serveur)
# VITE_API_URL=http://backend.example.com:8000

# Pour utiliser avec docker-compose
# VITE_API_URL=http://backend:8000


