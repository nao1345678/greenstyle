{
  "name": "GreenStyle - Détection de durabilité",
  "description": "Extension pour afficher les scores de durabilité des marques de mode",
  "version": "2.0.0",
  "manifest_version": 3,

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon_extension.png"
  },
  "icons": { "128": "icon_extension.png" },

  "permissions": ["storage", "tabs", "activeTab"],

  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://*/*",
    "http://*/*"
  ],

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_brand_detection.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
