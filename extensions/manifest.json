{
  "name": "PLI - GreenStyle",
  "description": "Base Level Extension",
  "version": "1.0.1",
  "manifest_version": 3,

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon_extension.png"
  },
  "icons": { "128": "icon_extension.png" },

  "permissions": ["storage"],

  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
    }

}
